# ==============================================================================
# TBH — "Ride Beyond Limits" Environment Configuration
# ==============================================================================

# Application Profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# MySQL 8.x Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tbh
DB_USER=root
DB_PASSWORD=

# JWT Authentication Secret (Min 256 bits HMAC-SHA256)
TBH_JWT_SECRET=tbh-ride-beyond-limits-super-secret-key-2026-production-grade-encryption
TBH_JWT_ACCESS_EXPIRATION_MS=900000
TBH_JWT_REFRESH_EXPIRATION_MS=604800000

# OTP Provider: 'mock' (logs to server console in dev) | 'sms' (production gateway)
TBH_OTP_PROVIDER=mock
TBH_SMS_API_KEY=

# Razorpay Payment Gateway (Test or Live)
TBH_PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

